# Care CMS - Production Deployment GitIgnore

# Environment files
.env
.env.local
.env.production
.env.staging

# Database files
*.sql
*.db
*.sqlite

# Logs
logs/*.log
*.log
error.log
access.log

# Cache and temporary files
cache/
tmp/
temp/
*.tmp
*.cache

# Node modules (for Tailwind CSS)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# PHP specific
composer.phar
vendor/
*.php~

# Security sensitive files
config/local.php
config/production.php
includes/local_config.php

# Backup files
*.bak
*.backup
backup/

# Test files
test_*.php
debug_*.php
*_test.php

# Development files
dev/
development/
local/

# Uploaded files (if any)
uploads/
files/
media/

# Session files
sessions/

# Rate limiting data
logs/rate_limits.json

# Archive files
*.zip
*.tar.gz
*.rar