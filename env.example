# Care CMS - Production Environment Variables

# Database Configuration
DB_HOST=localhost
DB_NAME=u123456789_care_cms
DB_USER=u123456789_care
DB_PASS=your_secure_password_here

# Security Keys (Generate new ones for production)
ENCRYPTION_KEY=your_32_character_encryption_key_here
JWT_SECRET=your_jwt_secret_key_here

# Email Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=admin@olshacare.com
SMTP_PASS=your_email_password_here

# Domain Configuration
BASE_URL=https://olshacare.com
ADMIN_EMAIL=admin@olshacare.com

# Production Settings
ENVIRONMENT=production
DEBUG_MODE=false
LOG_LEVEL=error

# Performance Settings
CACHE_ENABLED=true
CACHE_LIFETIME=3600
COMPRESSION_ENABLED=true

# Security Settings
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
SESSION_LIFETIME=3600
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# Backup Settings
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# Monitoring
MONITORING_ENABLED=true
ERROR_REPORTING=false

# RFID Configuration
RFID_ENABLED=true
RFID_TIMEOUT=30

# Archive Settings
AUTO_ARCHIVE_ENABLED=true
ARCHIVE_AFTER_DAYS=365

# File Upload Settings
MAX_UPLOAD_SIZE=10M
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Database Connection Pooling
DB_POOL_SIZE=10
DB_TIMEOUT=30

# File Permissions
FILE_PERMISSIONS=644
DIRECTORY_PERMISSIONS=755

# Logging Configuration
LOG_FILE=/home/u123456789/domains/olshacare.com/public_html/logs/app.log
LOG_MAX_SIZE=10MB
LOG_ROTATION=true

# Memory and Execution Limits
MEMORY_LIMIT=256M
MAX_EXECUTION_TIME=300
MAX_INPUT_TIME=300
