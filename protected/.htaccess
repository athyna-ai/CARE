# Security Framework - Protected Pages Directory
# Additional protection for sensitive administrative pages

# Require authentication for all files in this directory
AuthType Basic
AuthName "Protected Area"
AuthUserFile /path/to/.htpasswd
Require valid-user

# Deny direct access to PHP files without authentication
<FilesMatch "\.php$">
    Require valid-user
</FilesMatch>

# Security headers
Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options DENY
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Disable directory browsing
Options -Indexes

# Custom error pages
ErrorDocument 401 "Authentication Required - Security Framework Protected"
ErrorDocument 403 "Access Denied - Security Framework Protected"
ErrorDocument 404 "Page Not Found - Security Framework Protected"

# Additional security measures
<IfModule mod_security.c>
    SecRuleEngine On
    SecRule REQUEST_METHOD "@streq GET" \
        "id:2001,phase:1,capture,msg:'GET request to protected admin area',logdata:'Matched Data: %{MATCHED_VAR}'"
</IfModule>
